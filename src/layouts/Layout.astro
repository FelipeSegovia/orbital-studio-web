---
import { site } from "../config/site";
import SeoSchema from "../components/SeoSchema.astro";

interface Props {
	title?: string;
	description?: string;
	/** Ruta o URL de la imagen social. Se resuelve contra el dominio de producción. */
	image?: string;
	/** Excluye la página del índice (por ejemplo, la 404). */
	noindex?: boolean;
}

const {
	title = "Orbital Studio — Ingeniería y diseño digital",
	description =
		"Estudio de ingeniería y diseño digital en La Serena, Chile. Diseño, desarrollo web y software a medida. Trabajamos de forma remota con todo el país.",
	image = "/og.png",
	noindex = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const robots = noindex ? "noindex, follow" : "index, follow, max-image-preview:large";
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;
const ogImageAlt = "Orbital Studio — ingeniería y diseño digital, La Serena, Chile";
---

<!doctype html>
<html lang="es-CL">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonical} />
		<meta name="theme-color" content="#000000" />
		<meta name="color-scheme" content="dark" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_CL" />
		<meta property="og:site_name" content={site.companyName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link
			rel="preload"
			href="/fonts/archivo-latin-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<meta name="generator" content={Astro.generator} />
		<SeoSchema />
	</head>
	<body>
		<a class="skip-link" href="#contenido">Saltar al contenido</a>
		<slot />
	</body>
</html>

<style is:global>
	@import "../styles/global.css";
</style>
