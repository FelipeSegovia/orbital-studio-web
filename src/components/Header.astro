---
import Logo from "./Logo.astro";
---

<header class="header">
	<nav class="header__nav container" aria-label="Principal">
		<Logo variant="header" />
		<div class="header__links">
			<a class="header__link" href="#servicios">Servicios</a>
			<a class="header__link" href="#en-orbita">En órbita</a>
			<a class="header__link" href="#estudio">Estudio</a>
			<a class="header__link" href="#nosotros">Nosotros</a>
		</div>
		<a class="header__cta" href="#contacto">Hablemos</a>
	</nav>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 20;
		backdrop-filter: blur(14px);
		background: rgba(0, 0, 0, 0.86);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.header__nav {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 12px 24px;
		padding-top: 10px;
		padding-bottom: 10px;
	}

	.header__links {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 8px 12px;
		flex-wrap: wrap;
	}

	.header__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 10px;
		font-size: 13.5px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.72);
		transition: color 0.2s ease;
	}

	.header__link:hover {
		color: #ffffff;
	}

	.header__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		font-size: 13px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #000000;
		background: var(--color-lime);
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 10px;
		padding: 11px 20px;
		font-weight: 600;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.45),
			0 10px 26px rgba(198, 255, 51, 0.22);
		transition: filter 0.2s ease;
	}

	.header__cta:hover {
		filter: brightness(1.12);
		color: #000000;
	}

	@media (max-width: 640px) {
		.header__nav {
			grid-template-columns: 1fr auto;
		}

		.header__links {
			grid-column: 1 / -1;
			justify-content: flex-start;
			gap: 0 4px;
		}
	}
</style>
