---
import Logo from "./Logo.astro";
import { site } from "../config/site";

const { contactEmail, phone, phoneDisplay, city } = site;

const sections = [
	{ href: "#servicios", label: "Servicios" },
	{ href: "#en-orbita", label: "En órbita" },
	{ href: "#estudio", label: "El estudio" },
	{ href: "#nosotros", label: "Nosotros" },
	{ href: "#contacto", label: "Hablemos" },
];
---

<footer class="footer">
	<div class="container footer__inner">
		<Logo variant="footer" />
		<p class="footer__tagline">
			<span class="footer__tagline-light">Escuchamos tu negocio. </span>
			<span class="footer__tagline-em">Diseñamos su futuro digital.</span>
		</p>
		<span class="footer__copy">© 2026 Orbital Studio</span>
	</div>

	<div class="container footer__meta">
		<nav class="footer__nav" aria-label="Secciones">
			{sections.map((section) => <a href={section.href}>{section.label}</a>)}
		</nav>
		<address class="footer__nap">
			<span>{city}, Chile</span>
			<span class="footer__dot" aria-hidden="true">·</span>
			<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
			<span class="footer__dot" aria-hidden="true">·</span>
			<a href={`tel:${phone}`}>{phoneDisplay}</a>
		</address>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--color-border);
	}

	.footer__inner {
		padding-top: 44px;
		padding-bottom: 44px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		flex-wrap: wrap;
	}

	.footer__tagline {
		margin: 0;
		font-size: 13.5px;
		letter-spacing: 0.02em;
		color: rgba(255, 255, 255, 0.5);
		flex: 1;
		min-width: 200px;
		text-align: center;
	}

	.footer__tagline-light {
		font-weight: 200;
	}

	.footer__tagline-em {
		font-style: italic;
		font-weight: 600;
	}

	.footer__copy {
		font-size: 13px;
		color: rgba(255, 255, 255, 0.62);
	}

	.footer__meta {
		padding-bottom: 44px;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 16px 32px;
		border-top: 1px solid var(--color-border-soft);
		padding-top: 24px;
	}

	.footer__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 24px;
	}

	.footer__nav a,
	.footer__nap a {
		font-size: 13.5px;
		color: rgba(255, 255, 255, 0.62);
		text-decoration: none;
	}

	.footer__nav a:hover,
	.footer__nap a:hover {
		color: var(--color-lime);
	}

	.footer__nap {
		font-style: normal;
		font-size: 13.5px;
		color: rgba(255, 255, 255, 0.62);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 4px;
	}

	.footer__dot {
		color: rgba(255, 255, 255, 0.3);
		margin: 0 4px;
	}

	@media (max-width: 768px) {
		.footer__inner {
			flex-direction: column;
			align-items: flex-start;
		}

		.footer__tagline {
			text-align: left;
		}
	}
</style>
