---
import { site } from "../config/site";

const email = site.contactEmail;
const { phone, phoneDisplay, whatsapp, locationLabel } = site;
---

<section id="contacto" class="contact">
	<div class="container contact__grid">
		<div class="contact__info">
			<span class="eyebrow">Hablemos</span>
			<h2 class="contact__title">
				<span class="contact__title-light">Cuéntanos tu negocio.</span>
				<span class="contact__title-bold">El resto lo ordenamos nosotros.</span>
			</h2>
			<p class="contact__lead">
				Una primera conversación de treinta minutos, sin costo, para entender qué necesitas y qué conviene hacer
				primero.
			</p>
			<dl class="contact__details">
				<div class="contact__detail">
					<dt>Correo</dt>
					<dd><a href={`mailto:${email}`}>{email}</a></dd>
				</div>
				<div class="contact__detail">
					<dt>Teléfono</dt>
					<dd>
						<a href={`tel:${phone}`}>{phoneDisplay}</a>
						<span class="contact__sep" aria-hidden="true">·</span>
						<a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener noreferrer">
							WhatsApp<span class="visually-hidden"> (se abre en una pestaña nueva)</span>
						</a>
					</dd>
				</div>
				<div class="contact__detail">
					<dt>Dónde</dt>
					<dd>{locationLabel}</dd>
				</div>
			</dl>
		</div>

		<form
			class="contact__form glass-card"
			id="contact-form"
			novalidate
			data-contact-email={email}
		>
			<div class="contact__fields-row">
				<label class="contact__field">
					<span>Nombre</span>
					<input
						type="text"
						name="name"
						placeholder="Tu nombre"
						required
						autocomplete="name"
						aria-describedby="error-name"
					/>
					<span class="contact__error" id="error-name" role="alert"></span>
				</label>
				<label class="contact__field">
					<span>Correo</span>
					<input
						type="email"
						name="email"
						placeholder="tu@correo.cl"
						required
						autocomplete="email"
						aria-describedby="error-email"
					/>
					<span class="contact__error" id="error-email" role="alert"></span>
				</label>
			</div>
			<label class="contact__field">
				<span>Qué necesitas</span>
				<textarea
					name="message"
					rows="5"
					placeholder="Cuéntanos en qué está tu negocio hoy y qué te gustaría resolver."
					required
					aria-describedby="error-message"></textarea>
				<span class="contact__error" id="error-message" role="alert"></span>
			</label>
			<button class="contact__submit" type="submit" id="contact-submit">Enviar</button>
			<p class="contact__note" id="form-note" role="status" aria-live="polite">
				Te respondemos a la brevedad. También puedes escribirnos a {email}.
			</p>
		</form>
	</div>
</section>

<script>
	import { actions, isInputError } from "astro:actions";

	const form = document.getElementById("contact-form");
	const note = document.getElementById("form-note");
	const submit = document.getElementById("contact-submit");

	if (form instanceof HTMLFormElement && submit instanceof HTMLButtonElement) {
		const email = form.dataset.contactEmail ?? "contacto@orbitalstudio.cl";
		const fields = [
			{
				name: "name",
				empty: "Escribe tu nombre.",
			},
			{
				name: "email",
				empty: "Escribe tu correo.",
				invalid: "Revisa el formato del correo.",
			},
			{
				name: "message",
				empty: "Cuéntanos qué necesitas.",
			},
		];

		const defaultNote = `Te respondemos a la brevedad. También puedes escribirnos a ${email}.`;
		const sendErrorNote = `No pudimos enviar el mensaje ahora. Escríbenos a ${email}.`;

		function setFieldError(input, errorEl, message) {
			input.setAttribute("aria-invalid", message ? "true" : "false");
			if (errorEl) errorEl.textContent = message;
		}

		function clearErrors() {
			for (const field of fields) {
				const input = form.elements.namedItem(field.name);
				const errorEl = document.getElementById(`error-${field.name}`);
				if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement)) continue;
				setFieldError(input, errorEl, "");
			}
		}

		function validate() {
			let firstInvalid = null;

			for (const field of fields) {
				const input = form.elements.namedItem(field.name);
				const errorEl = document.getElementById(`error-${field.name}`);
				if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement)) continue;

				const value = input.value.trim();
				let message = "";

				if (!value) {
					message = field.empty;
				} else if (field.name === "email" && !input.checkValidity()) {
					message = field.invalid;
				}

				setFieldError(input, errorEl, message);
				if (message && !firstInvalid) firstInvalid = input;
			}

			if (firstInvalid) firstInvalid.focus();
			return !firstInvalid;
		}

		function applyServerFieldErrors(error) {
			if (!isInputError(error) || !error.fields) return false;

			let firstInvalid = null;
			for (const field of fields) {
				const messages = error.fields[field.name];
				const input = form.elements.namedItem(field.name);
				const errorEl = document.getElementById(`error-${field.name}`);
				if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement)) continue;
				const message = Array.isArray(messages) ? (messages[0] ?? "") : "";
				setFieldError(input, errorEl, message);
				if (message && !firstInvalid) firstInvalid = input;
			}
			if (firstInvalid) firstInvalid.focus();
			return true;
		}

		for (const field of fields) {
			const input = form.elements.namedItem(field.name);
			if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement)) continue;
			input.addEventListener("input", () => {
				const errorEl = document.getElementById(`error-${field.name}`);
				if (input.getAttribute("aria-invalid") === "true") {
					const value = input.value.trim();
					if (value && input.checkValidity()) setFieldError(input, errorEl, "");
				}
			});
		}

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!validate()) return;

			clearErrors();
			submit.disabled = true;
			submit.textContent = "Enviando…";
			if (note) note.textContent = "Enviando tu mensaje…";

			try {
				const formData = new FormData(form);
				const { error } = await actions.contact.send(formData);

				if (error) {
					if (applyServerFieldErrors(error)) {
						if (note) note.textContent = defaultNote;
					} else if (note) {
						note.textContent = error.message || sendErrorNote;
					}
					return;
				}

				form.reset();
				clearErrors();
				if (note) {
					note.textContent = "Listo. Recibimos tu mensaje y te responderemos pronto.";
				}
			} catch {
				if (note) note.textContent = sendErrorNote;
			} finally {
				submit.disabled = false;
				submit.textContent = "Enviar";
			}
		});
	}
</script>

<style>
	.contact {
		border-top: 1px solid var(--color-border-soft);
		background: radial-gradient(80% 120% at 12% 0%, rgba(198, 255, 51, 0.1), transparent 60%);
	}

	.contact__grid {
		padding-top: 96px;
		padding-bottom: 104px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
		gap: 56px;
		align-items: start;
	}

	.contact__info {
		display: flex;
		flex-direction: column;
		gap: 26px;
	}

	.contact__title {
		font-family: var(--font-display);
		font-size: clamp(32px, 4vw, 52px);
		line-height: 1.02;
		margin: 0;
		letter-spacing: -0.035em;
		text-wrap: pretty;
		font-variation-settings: "wdth" 118;
	}

	.contact__title-light {
		display: block;
		font-weight: 200;
		color: #ffffff;
	}

	.contact__title-bold {
		display: block;
		font-weight: 800;
		color: var(--color-lilac);
		font-size: clamp(28px, 3.5vw, 47px);
	}

	.contact__lead {
		margin: 0;
		font-size: 16px;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.7);
		max-width: 46ch;
		text-wrap: pretty;
	}

	.contact__details {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding-top: 24px;
	}

	.contact__detail {
		display: flex;
		gap: 16px;
		align-items: baseline;
	}

	.contact__detail dt {
		font-size: 11.5px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.62);
		width: 92px;
		flex: none;
		margin: 0;
	}

	.contact__detail dd {
		margin: 0;
		font-size: 16px;
		color: rgba(255, 255, 255, 0.8);
	}

	.contact__sep {
		margin: 0 8px;
		color: rgba(255, 255, 255, 0.3);
	}

	.contact__form {
		padding: 34px;
		display: flex;
		flex-direction: column;
		gap: 20px;
		backdrop-filter: blur(22px) saturate(1.3);
		-webkit-backdrop-filter: blur(22px) saturate(1.3);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.14),
			0 22px 54px rgba(0, 0, 0, 0.45);
	}

	.contact__fields-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr));
		gap: 20px;
	}

	.contact__field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.contact__field > span:first-of-type {
		font-size: 11.5px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.62);
	}

	.contact__error {
		min-height: 1.2em;
		font-size: 13px;
		letter-spacing: 0;
		text-transform: none;
		color: var(--color-lime);
	}

	.contact__field input,
	.contact__field textarea {
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 10px;
		color: #ffffff;
		padding: 13px 14px;
		font-size: 15px;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
		resize: vertical;
	}

	.contact__field input:focus,
	.contact__field textarea:focus {
		border-color: var(--color-lime);
	}

	.contact__field input[aria-invalid="true"],
	.contact__field textarea[aria-invalid="true"] {
		border-color: var(--color-lime);
	}

	.contact__submit {
		font-size: 13.5px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #000000;
		background: var(--color-lime);
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 10px;
		padding: 16px 24px;
		min-height: 44px;
		font-weight: 600;
		cursor: pointer;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.45),
			0 12px 30px rgba(198, 255, 51, 0.24);
		transition: filter 0.2s ease;
	}

	.contact__submit:hover:not(:disabled) {
		filter: brightness(1.12);
	}

	.contact__submit:disabled {
		opacity: 0.7;
		cursor: wait;
	}

	.contact__note {
		margin: 0;
		font-size: 13px;
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.62);
	}
</style>
