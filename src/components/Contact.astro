---
const email = "hola@orbitalstudio.cl";
---

<section id="contacto" class="contact">
	<div class="container contact__grid">
		<div class="contact__info">
			<span class="eyebrow">Hablemos</span>
			<h2 class="contact__title">
				<span class="contact__title-light">Cuéntanos tu negocio.</span>
				<span class="contact__title-bold">El resto lo ordenamos nosotros.</span>
			</h2>
			<p class="contact__lead">
				Una primera conversación de treinta minutos, sin costo, para entender qué necesitas y qué conviene hacer
				primero.
			</p>
			<dl class="contact__details">
				<div class="contact__detail">
					<dt>Correo</dt>
					<dd><a href={`mailto:${email}`}>{email}</a></dd>
				</div>
				<div class="contact__detail">
					<dt>WhatsApp</dt>
					<dd><a href="#contacto">+56 9 0000 0000</a></dd>
				</div>
				<div class="contact__detail">
					<dt>Dónde</dt>
					<dd>Santiago, Chile — trabajamos remoto</dd>
				</div>
			</dl>
		</div>

		<form class="contact__form glass-card" id="contact-form" novalidate>
			<div class="contact__fields-row">
				<label class="contact__field">
					<span>Nombre</span>
					<input type="text" name="nombre" placeholder="Tu nombre" required autocomplete="name" />
				</label>
				<label class="contact__field">
					<span>Correo</span>
					<input type="email" name="correo" placeholder="tu@correo.cl" required autocomplete="email" />
				</label>
			</div>
			<label class="contact__field">
				<span>Qué necesitas</span>
				<textarea
					name="mensaje"
					rows="5"
					placeholder="Cuéntanos en qué está tu negocio hoy y qué te gustaría resolver."
					required></textarea>
			</label>
			<button class="contact__submit" type="submit">Enviar mensaje</button>
			<p class="contact__note" id="form-note">
				Al enviar se abrirá tu cliente de correo con el mensaje preparado para {email}.
			</p>
		</form>
	</div>
</section>

<script define:vars={{ email }}>
	const form = document.getElementById("contact-form");
	const note = document.getElementById("form-note");

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		if (!(form instanceof HTMLFormElement)) return;

		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		const data = new FormData(form);
		const nombre = String(data.get("nombre") ?? "").trim();
		const correo = String(data.get("correo") ?? "").trim();
		const mensaje = String(data.get("mensaje") ?? "").trim();

		const subject = encodeURIComponent(`Consulta desde la web — ${nombre}`);
		const body = encodeURIComponent(
			`Nombre: ${nombre}\nCorreo: ${correo}\n\n${mensaje}`,
		);

		window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;

		if (note) {
			note.textContent =
				"Si no se abrió tu correo, escríbenos directamente a " + email + ".";
		}
	});
</script>

<style>
	.contact {
		border-top: 1px solid var(--color-border-soft);
		background: radial-gradient(80% 120% at 12% 0%, rgba(198, 255, 51, 0.1), transparent 60%);
	}

	.contact__grid {
		padding-top: 96px;
		padding-bottom: 104px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 56px;
		align-items: start;
	}

	.contact__info {
		display: flex;
		flex-direction: column;
		gap: 26px;
	}

	.contact__title {
		font-family: var(--font-display);
		font-size: clamp(32px, 4vw, 52px);
		line-height: 1.02;
		margin: 0;
		letter-spacing: -0.035em;
		text-wrap: pretty;
		font-variation-settings: "wdth" 118;
	}

	.contact__title-light {
		display: block;
		font-weight: 200;
		color: #ffffff;
	}

	.contact__title-bold {
		display: block;
		font-weight: 800;
		color: var(--color-lilac);
		font-size: clamp(28px, 3.5vw, 47px);
	}

	.contact__lead {
		margin: 0;
		font-size: 16px;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.7);
		max-width: 46ch;
		text-wrap: pretty;
	}

	.contact__details {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding-top: 24px;
	}

	.contact__detail {
		display: flex;
		gap: 16px;
		align-items: baseline;
	}

	.contact__detail dt {
		font-size: 11.5px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.45);
		width: 92px;
		flex: none;
		margin: 0;
	}

	.contact__detail dd {
		margin: 0;
		font-size: 16px;
		color: rgba(255, 255, 255, 0.8);
	}

	.contact__form {
		padding: 34px;
		display: flex;
		flex-direction: column;
		gap: 20px;
		backdrop-filter: blur(22px) saturate(1.3);
		-webkit-backdrop-filter: blur(22px) saturate(1.3);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.14),
			0 22px 54px rgba(0, 0, 0, 0.45);
	}

	.contact__fields-row {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 20px;
	}

	.contact__field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.contact__field span {
		font-size: 11.5px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.55);
	}

	.contact__field input,
	.contact__field textarea {
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 10px;
		color: #ffffff;
		padding: 13px 14px;
		font-size: 15px;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
		resize: vertical;
	}

	.contact__field input:focus,
	.contact__field textarea:focus {
		border-color: var(--color-lime);
		outline: none;
	}

	.contact__submit {
		font-size: 13.5px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #000000;
		background: var(--color-lime);
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 10px;
		padding: 16px 24px;
		font-weight: 600;
		cursor: pointer;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.45),
			0 12px 30px rgba(198, 255, 51, 0.24);
		transition: filter 0.2s ease;
	}

	.contact__submit:hover {
		filter: brightness(1.12);
	}

	.contact__note {
		margin: 0;
		font-size: 13px;
		line-height: 1.55;
		color: rgba(255, 255, 255, 0.5);
	}
</style>
