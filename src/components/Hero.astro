---
import arcSvg from "../assets/orbital-arc.svg?raw";
---

<section id="inicio" class="hero">
	<span class="hero__glow" aria-hidden="true"></span>
	<div class="hero__arc" aria-hidden="true" set:html={arcSvg} />
	<span class="hero__shade" aria-hidden="true"></span>

	<div class="hero__inner container">
		<div class="hero__content">
			<span class="eyebrow eyebrow--wide">Ingeniería y diseño digital</span>
			<h1 class="hero__title">
				<span class="hero__title-light">Escuchamos tu negocio.</span>
				<span class="hero__title-bold">Diseñamos su futuro digital.</span>
			</h1>
			<p class="hero__lead">
				Somos un estudio de ingeniería y diseño digital que
				<em>transforma la lógica de los negocios en sistemas</em>.
			</p>
			<div class="hero__actions">
				<a class="btn-primary" href="#contacto">Conversemos tu proyecto</a>
				<a class="btn-secondary" href="#servicios">Ver servicios</a>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border-soft);
		min-height: 73vh;
		display: flex;
		align-items: center;
	}

	.hero__glow {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(
				48% 54% at 84% 58%,
				rgba(199, 155, 255, 0.4) 0%,
				rgba(125, 57, 235, 0.16) 46%,
				transparent 74%
			),
			radial-gradient(
				38% 44% at 30% 30%,
				rgba(74, 42, 232, 0.3) 0%,
				transparent 70%
			);
		animation: glowPulse 8s ease-in-out infinite;
	}

	.hero__shade {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(
				70% 90% at 4% 62%,
				rgba(0, 0, 0, 0.8) 0%,
				rgba(0, 0, 0, 0.45) 44%,
				transparent 76%
			),
			linear-gradient(
				92deg,
				rgba(43, 10, 104, 0.4) 0%,
				rgba(43, 10, 104, 0.22) 34%,
				rgba(43, 10, 104, 0) 62%
			);
	}

	.hero__arc {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.hero__arc :global(svg) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero__arc :global(svg > g) {
		transform-origin: 800px 450px;
		animation: arcDrift 14s ease-in-out infinite alternate;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__glow,
		.hero__arc :global(svg > g),
		.hero__arc :global(svg path),
		.hero__arc :global(svg circle) {
			animation: none;
		}
	}

	.hero__inner {
		position: relative;
		width: 100%;
		padding-top: 104px;
		padding-bottom: 112px;
	}

	.hero__content {
		display: flex;
		flex-direction: column;
		gap: 28px;
		max-width: 640px;
	}

	.hero__title {
		font-family: var(--font-display);
		font-size: clamp(38px, 5.2vw, 66px);
		line-height: 1.02;
		margin: 0;
		letter-spacing: -0.035em;
		text-wrap: pretty;
		font-variation-settings: "wdth" 118;
	}

	.hero__title-light {
		display: block;
		font-weight: 200;
		color: #ffffff;
	}

	.hero__title-bold {
		display: block;
		font-weight: 800;
		color: var(--color-lilac);
	}

	.hero__lead {
		margin: 0;
		font-size: 18px;
		line-height: 1.6;
		max-width: 50ch;
		color: rgba(255, 255, 255, 0.74);
		text-wrap: pretty;
	}

	.hero__lead em {
		font-style: italic;
		font-weight: 500;
		color: #ffffff;
	}

	.hero__actions {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
		padding-top: 4px;
	}

	@media (max-width: 768px) {
		.hero__inner {
			padding-top: 72px;
			padding-bottom: 80px;
		}
	}
</style>
